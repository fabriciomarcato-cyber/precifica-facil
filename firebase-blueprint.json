{
  "entities": {
    "Coupon": {
      "title": "Coupon",
      "description": "A coupon or email-based access that grants temporary full access to the application.",
      "type": "object",
      "properties": {
        "codigo": {
          "type": "string",
          "description": "The unique code or email for the access."
        },
        "status": {
          "type": "string",
          "enum": ["disponivel", "usado"],
          "description": "The current status of the access."
        },
        "data_ativacao": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the access was activated."
        },
        "data_vencimento": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the access expires."
        },
        "used_by_uid": {
          "type": "string",
          "description": "The UID of the user who activated the access."
        }
      },
      "required": ["codigo", "status"]
    },
    "User": {
      "title": "User",
      "description": "User profile and access information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "active_coupon": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Collection of coupons."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    }
  }
}
