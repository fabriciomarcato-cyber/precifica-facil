// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: coupons
// Document ID: User Email (lowercase) or Coupon Code
// Fields:
//   - codigo: string (required) - The unique code or email
//   - status: string (required) - 'disponivel' or 'usado'
//   - data_ativacao: timestamp (optional) - When activated
//   - data_vencimento: timestamp (optional) - When expires
//   - used_by_uid: string (optional) - UID of user
//
// Collection: users
// Document ID: userId
// Fields:
//   - uid: string (required)
//   - email: string (required)
//   - role: string (required)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "fabricio.marcato@gmail.com" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidCoupon(data) {
      return data.code is string && data.code.size() > 0 &&
             data.status in ['available', 'used'] &&
             data.days_duration is number && data.days_duration > 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && 
                      request.resource.data.role == 'user';
      allow update: if isAdmin();
    }

    match /coupons/{couponId} {
      // Allow read if user is authenticated and their email matches the document ID (for email-based access)
      // Or if they are an admin
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email.lower() == couponId.lower());
      
      // Allow listing ONLY for admins
      allow list: if isAdmin();
      
      // Only admins can create or delete coupons
      allow create, delete: if isAdmin();

      // Users can "activate" a coupon or their email-based access
      allow update: if isAuthenticated() &&
        // 1. Access must be available
        (resource.data.status == 'disponivel' || resource.data.status == 'available') &&
        // 2. User is setting it to used
        request.resource.data.status == 'usado' &&
        // 3. User is setting themselves as the owner
        request.resource.data.used_by_uid == request.auth.uid &&
        // 4. Activation date is the current server time
        request.resource.data.data_ativacao == request.time &&
        // 5. Expiration date is 1 year (365 days)
        request.resource.data.data_vencimento == request.time + duration.value(365, 'd') &&
        // 6. If it's email-based access (ID is an email), ensure it matches the user's email
        (couponId.lower().contains('@') ? couponId.lower() == request.auth.token.email.lower() : true);
    }
  }
}
